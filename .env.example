# Copy to .env and fill in. Both runners load .env automatically.
#
# HF_TOKEN
#   Required by the WHITE-BOX experiments to download and load local
#   Hugging Face models (white_box_model_experiments/run.py).
#   Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# OPENROUTER_API_KEY
#   Required by ALL black-box experiments, and by the LLM judges used
#   throughout - including in white-box runs, which call OpenRouter for
#   hallucination judging, semantic equivalence and embeddings.
#   Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
